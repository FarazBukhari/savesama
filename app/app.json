{
  "expo": {
    "name": "SaveSama",
    "slug": "savesama",
    "owner": "farazbukhari",
    "scheme": "savesama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F3EF",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "com.foxysama.savesama",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFD12E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true,
          "cameraPermission": "SaveSama uses the camera to scan your server's pairing code."
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFD12E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#F0C52B"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "56b9a925-7dc3-4721-bb0d-0cebbe602a50"
      }
    }
  }
}